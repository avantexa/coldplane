# Linux release builds. Plain bookworm on purpose: the binaries link against
# this image's glibc and libstdc++, so nothing here may come from a newer
# Debian. Result: glibc 2.34 and libstdc++ from GCC 12 (Ubuntu 22.04+,
# Debian 12+, Fedora 36+).
FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-x86-64-linux-gnu g++-x86-64-linux-gnu \
    gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
